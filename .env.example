# ── Gateway ──────────────────────────────────────────────
GATEWAY_PORT=4000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Rutas a claves RSA para firmar JWT (RS256). Si se omiten,
# en desarrollo se genera un par efímero al arrancar.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# URL interna del servicio de música
MUSIC_SERVICE_URL=http://localhost:4002

# ── Music service ────────────────────────────────────────
MUSIC_PORT=4002
# API key gratuita: https://devportal.jamendo.com/ (registro gratis)
JAMENDO_CLIENT_ID=tu_client_id_aqui
# Audius no requiere API key, solo un nombre de app
AUDIUS_APP_NAME=soundmind

# ── Frontend (apps/web usa prefijo VITE_) ────────────────
VITE_API_URL=http://localhost:4000/api/v1
