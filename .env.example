# ── Gateway ──────────────────────────────────────────────
GATEWAY_PORT=4000
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
# Claves RSA para firmar JWT (RS256). Opciones (en orden de prioridad):
#   a) Contenido PEM directo (para PaaS tipo Render — pegar el PEM multilínea)
#   b) Rutas a archivos .pem en disco
#   c) Si se omiten ambas: par efímero al arrancar (solo desarrollo)
# Generar par para producción:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# URLs internas de los servicios (el gateway hace de BFF/proxy)
MUSIC_SERVICE_URL=http://localhost:4002
USERS_SERVICE_URL=http://localhost:4003

# ── Music service ────────────────────────────────────────
MUSIC_PORT=4002
# API key gratuita: https://devportal.jamendo.com/ (registro gratis)
JAMENDO_CLIENT_ID=tu_client_id_aqui
# Audius no requiere API key, solo un nombre de app
AUDIUS_APP_NAME=soundmind

# ── Frontend (apps/web usa prefijo VITE_) ────────────────
VITE_API_URL=http://localhost:4000/api/v1

# ── F2: Users service (PostgreSQL + Redis Streams) ───────
USERS_PORT=4003
# Verifica los JWT del gateway con la MISMA clave pública (RS256). El users
# service solo necesita la pública: usa JWT_PUBLIC_KEY o JWT_PUBLIC_KEY_PATH de arriba.
# Nombre del Redis Stream de eventos de escucha (consumido por el recomendador en F3).
LISTEN_EVENTS_STREAM=listen-events
# Neon (https://neon.tech, free tier): botón "Connect" del proyecto (usar endpoint POOLED)
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require
# Upstash (https://upstash.com, free tier): OJO, con TLS es rediss:// (doble s)
REDIS_URL=rediss://default:token@host.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://host.upstash.io
UPSTASH_REDIS_REST_TOKEN=token_aqui
